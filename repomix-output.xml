                                </div>
                                <div className="flex items-center gap-2">
                                    <Link
                                        href={`/templates/${t.id}`}
                                        className="p-2 rounded-lg text-[var(--muted)] hover:text-[var(--foreground)] hover:bg-[var(--surface-hover)] transition-colors"
                                        title="View"
                                    >
                                        <Eye className="w-4 h-4" />
