{
    "output": {
        "filePath": "repomix-output.xml",
        "style": "xml"
    },
    "ignore": {
        "useGitignore": true,
        "useDefaultPatterns": true,
        "customPatterns": [
            "node_modules/**",
            ".next/**",
            ".env*",
            "pnpm-lock.yaml",
            "package-lock.json",
            "samples/**",
            "repomix-output.txt",
            "*.pdf",
            "*.png",
            "*.jpg",
            "*.jpeg",
            "*.gif",
            "*.svg",
            "*.ico",
            "*.woff",
            "*.woff2",
            "*.ttf",
            "*.eot",
            "stitch.json",
            ".gitignore",
            "tsconfig.json",
            "postcss.config.mjs",
            "eslint.config.mjs",
            "tailwind.config.ts",
            "My Upcoming Concert*"
        ]
    }
}